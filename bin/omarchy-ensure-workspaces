#!/bin/bash
# omarchy:summary=Ensure persistent workspaces exist on all monitors (with retry)
# omarchy:hidden=true
#
# Delayed verification helper: confirm that all workspace slots (1-30) exist
# as persistent workspaces after global workspace mode initializes.
#
# Called by workspace-global.lua as a backgrounded post-init check:
#   os.execute("omarchy-ensure-workspaces &")
#
# This runs after a short delay to give hl.workspace_rule() time to materialize
# workspaces asynchronously (the rule registration is not synchronous).
# If any expected workspace is missing, re-dispatches focus to create it.
#
# Slot range: 1-10 per monitor, for however many monitors are in the bases file.
# If monitor-bases.json is absent or empty, exits silently (local mode active).

sleep 1  # Give Hyprland time to materialize workspace rules

BASES_FILE="$HOME/.local/state/omarchy/monitor-bases.json"
if [[ ! -f "$BASES_FILE" ]]; then
  exit 0
fi

# Only run inside a live Hyprland session
if [[ -z "$HYPRLAND_INSTANCE_SIGNATURE" ]]; then
  exit 0
fi

python3 - "$BASES_FILE" <<'PYEOF'
import json, subprocess, sys, os

bases_file = sys.argv[1]
try:
    with open(bases_file) as f:
        bases = json.load(f)
except Exception:
    sys.exit(0)

if not bases:
    sys.exit(0)

# Get existing workspace IDs from hyprctl
try:
    result = subprocess.run(
        ["hyprctl", "workspaces", "-j"],
        capture_output=True, text=True, timeout=5
    )
    existing_ids = set()
    if result.returncode == 0:
        workspaces = json.loads(result.stdout)
        existing_ids = {ws["id"] for ws in workspaces}
except Exception:
    sys.exit(0)

# Check all expected slots for all monitors
missing = []
for name, base in bases.items():
    for slot in range(1, 11):
        ws_id = base + slot
        if ws_id not in existing_ids:
            missing.append(ws_id)

if not missing:
    sys.exit(0)

# Re-dispatch focus to missing workspaces to force materialization
for ws_id in sorted(missing):
    try:
        subprocess.run(
            ["hyprctl", "dispatch", f'hl.dsp.focus({{ workspace = "{ws_id}" }})'],
            capture_output=True, timeout=3
        )
    except Exception:
        pass

# Return focus to workspace 1
try:
    subprocess.run(
        ["hyprctl", "dispatch", 'hl.dsp.focus({ workspace = "1" })'],
        capture_output=True, timeout=3
    )
except Exception:
    pass

sys.exit(0)
PYEOF
